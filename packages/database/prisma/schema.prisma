
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DeploymentStatus {
  QUEUED
  PENDING
  PREPARING
  SOURCE_PREPARED
  CLONING
  BUILDING
  BUILD_SUCCEEDED
  DEPLOYING
  HEALTH_CHECKING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLING
  CANCELLED
  STOPPED
  ROLLED_BACK
}

enum BuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DeploymentBuildStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DeploymentBuildArtifactType {
  DOCKER_IMAGE_STORE
  OCI_ARCHIVE
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum DeploymentLogSource {
  BUILD
  RUNTIME
  SYSTEM
}

enum DeploymentLogStream {
  STDOUT
  STDERR
  SYSTEM
}

enum DeploymentLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  UNKNOWN
}

enum DeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
  PREVIEW
}

enum AuthProvider {
  EMAIL_PASSWORD
  GITHUB
  GOOGLE
  MICROSOFT
}

enum GitHubInstallationStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum GitHubRepositorySelection {
  ALL
  SELECTED
}

enum GitHubAppStatePurpose {
  INSTALL_CALLBACK
  INSTALL_AUTHORIZATION
}

enum DeploymentTriggerSource {
  MANUAL
  GITHUB_PUSH
  GITHUB_PULL_REQUEST
  SCHEDULE
  API
  ROLLBACK
}

enum DeploymentFailureCode {
  BUILD_FAILED
  DEPLOY_FAILED
  HEALTH_CHECK_FAILED
  RUNTIME_FAILED
  TIMEOUT
  CANCELLED
  UNKNOWN
}

enum DeploymentOutboxStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  DEAD
}

enum DeploymentOutboxEventType {
  DEPLOYMENT_REQUESTED
  BUILD_REQUESTED
  RUNTIME_REQUESTED
}

enum DeploymentSourceStatus {
  PENDING
  DOWNLOADING
  EXTRACTING
  READY
  FAILED
  CANCELLED
}

model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String               @unique
  name                String?
  imageUrl            String?
  accounts            Account[]
  sessions            Session[]
  memberships         WorkspaceMember[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  githubInstallations GitHubInstallation[] @relation("GitHubInstallationAuthorizedUser")
  githubAppsInstalled GitHubInstallation[] @relation("GitHubInstallationInstaller")
  githubAppStates     GitHubAppState[]
  triggeredDeployments Deployment[]        @relation("DeploymentTriggeredBy")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("users")
}

model Session {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String           @db.Uuid
  tokenHash         String           @unique
  csrfHash          String
  activeWorkspaceId String?          @db.Uuid
  expiresAt         DateTime
  revokedAt         DateTime?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace   Workspace?       @relation(fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  githubAppStates   GitHubAppState[]
  createdAt         DateTime         @default(now())

  @@unique([id, userId])
  @@index([userId, expiresAt])
  @@map("sessions")
}

model Account {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String       @db.Uuid
  provider               AuthProvider
  providerAccountId      String
  passwordHash           String?
  accessTokenCiphertext  String?
  refreshTokenCiphertext String?
  accessTokenKeyId       String?
  refreshTokenKeyId      String?
  expiresAt              DateTime?
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Workspace {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String               @unique
  members             WorkspaceMember[]
  activeSessions      Session[]
  projects            Project[]
  deployments         Deployment[]
  deploymentOutboxEvents DeploymentOutboxEvent[]
  auditLogs           AuditLog[]
  githubInstallations GitHubInstallation[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId     String           @db.Uuid
  userId          String           @db.Uuid
  role            WorkspaceRole
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  githubAppStates GitHubAppState[]

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Project {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                @db.Uuid
  name                 String
  description          String?               @db.VarChar(500)
  slug                 String
  repository           Repository?
  buildConfiguration   ProjectBuildConfiguration?
  deployments          Deployment[]
  environmentVariables EnvironmentVariable[]
  deploymentOutboxEvents DeploymentOutboxEvent[]
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([workspaceId, slug])
  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@map("projects")
}

model Repository {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String              @db.Uuid
  projectId               String              @unique @db.Uuid
  provider                String
  externalId              String
  installationId          String?             @db.Uuid
  installationWorkspaceId String?             @db.Uuid
  name                    String
  fullName                String?
  defaultBranch           String?
  selectedBranch          String?
  language                String?
  isPrivate               Boolean             @default(false)
  description             String?             @db.VarChar(500)
  githubOwnerLogin        String?
  githubOwnerType         String?
  stars                   Int                 @default(0)
  forks                   Int                 @default(0)
  openIssuesCount         Int                 @default(0)
  sizeKb                  Int                 @default(0)
  lastPushedAt            DateTime?
  githubUpdatedAt         DateTime?
  isArchived              Boolean             @default(false)
  lastSyncedAt            DateTime?
  cloneUrlCiphertext      String?
  project                 Project             @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  installation            GitHubInstallation? @relation(fields: [installationWorkspaceId, installationId], references: [workspaceId, id], onDelete: Restrict)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([workspaceId, provider, externalId])
  @@unique([workspaceId, projectId])
  @@index([workspaceId, projectId])
  @@index([installationWorkspaceId, installationId])
  @@map("repositories")
}

model ProjectBuildConfiguration {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                 @db.Uuid
  projectId            String                 @db.Uuid
  framework            String?                @db.VarChar(80)
  runtime              String?                @db.VarChar(80)
  packageManager       String?                @db.VarChar(80)
  rootDirectory        String?                @db.VarChar(500)
  installCommand       String?                @db.Text
  buildCommand         String?                @db.Text
  startCommand         String?                @db.Text
  dockerfilePath       String?                @db.VarChar(500)
  applicationPort      Int?
  buildTimeoutSeconds Int?                   @db.Integer
  environment          DeploymentEnvironment?
  project              Project                @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([workspaceId, projectId])
  @@index([workspaceId, updatedAt])
  @@map("project_build_configurations")
}

model GitHubInstallation {
  id                     String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String                    @db.Uuid
  installationId         BigInt                    @unique
  githubAccountId        BigInt
  accountLogin           String
  accountType            String
  repositorySelection    GitHubRepositorySelection
  status                 GitHubInstallationStatus  @default(ACTIVE)
  authorizedGithubUserId String
  authorizedUserId       String                    @db.Uuid
  installedByUserId      String                    @db.Uuid
  suspendedAt            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  workspace              Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorizedUser         User                      @relation("GitHubInstallationAuthorizedUser", fields: [authorizedUserId], references: [id], onDelete: Restrict)
  installedBy            User                      @relation("GitHubInstallationInstaller", fields: [installedByUserId], references: [id], onDelete: Restrict)
  repositories           Repository[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([githubAccountId])
  @@map("github_installations")
}

model GitHubAppState {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateHash       String                @unique
  userId          String                @db.Uuid
  sessionId       String                @db.Uuid
  workspaceId     String                @db.Uuid
  purpose         GitHubAppStatePurpose
  installationId  BigInt?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime              @default(now())
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         Session               @relation(fields: [sessionId, userId], references: [id, userId], onDelete: Cascade)
  workspaceMember WorkspaceMember       @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([sessionId, expiresAt])
  @@map("github_app_states")
}

model Deployment {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                  @db.Uuid
  projectId      String                  @db.Uuid
  environment    DeploymentEnvironment
  status         DeploymentStatus        @default(QUEUED)
  triggerSource  DeploymentTriggerSource @default(API)
  failureCode    DeploymentFailureCode?
  idempotencyKey String?
  gitRef         String?
  commitSha      String?
  rollbackOfId   String?                 @db.Uuid
  previousDeploymentId       String?                 @db.Uuid
  requestedBranch            String?                 @db.VarChar(255)
  commitMessage              String?                 @db.Text
  triggeredByUserId          String?                 @db.Uuid
  buildConfigurationSnapshot Json?
  queueJobId                 String?                 @unique @db.VarChar(128)
  failureMessage             String?                 @db.Text
  executionLeaseToken        String?                 @db.Uuid
  executionLeaseExpiresAt    DateTime?
  executionAttempt           Int                     @default(0)
  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project                 @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  rollbackOf     Deployment?             @relation("DeploymentRollback", fields: [workspaceId, projectId, rollbackOfId], references: [workspaceId, projectId, id], onDelete: Restrict)
  rollbacks      Deployment[]            @relation("DeploymentRollback")
  previousDeployment Deployment?         @relation("DeploymentPrevious", fields: [workspaceId, projectId, previousDeploymentId], references: [workspaceId, projectId, id], onDelete: Restrict)
  subsequentDeployments Deployment[]     @relation("DeploymentPrevious")
  triggeredBy    User?                    @relation("DeploymentTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  builds         Build[]
  logs           DeploymentLog[]
  outboxEvents   DeploymentOutboxEvent[]
  sourcePreparation DeploymentSourcePreparation?
  deploymentBuilds  DeploymentBuild[]
  runtimeInstances  DeploymentRuntimeInstance[]
  logEntries        DeploymentLogEntry[]
  logSequence       DeploymentLogSequence?
  logNotifications  DeploymentLogNotificationOutbox[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?

  @@unique([workspaceId, id])
  @@unique([workspaceId, projectId, id])
  @@unique([workspaceId, projectId, environment, idempotencyKey], map: "deployments_workspaceId_projectId_environment_idempotencyKey_ke")
  @@index([workspaceId, projectId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, environment, createdAt])
  @@index([workspaceId, projectId, status, createdAt])
  @@index([status, executionLeaseExpiresAt])
  @@index([workspaceId, triggeredByUserId, createdAt])
  @@map("deployments")
}

model DeploymentOutboxEvent {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String                       @db.Uuid
  projectId       String                       @db.Uuid
  deploymentId   String                       @db.Uuid
  eventType       DeploymentOutboxEventType
  status          DeploymentOutboxStatus       @default(PENDING)
  jobId           String                       @unique @db.VarChar(128)
  attemptCount    Int                          @default(0)
  nextAttemptAt   DateTime                     @default(now())
  leaseToken      String?                      @db.Uuid
  leaseExpiresAt  DateTime?
  publishedAt     DateTime?
  lastErrorCode   String?                      @db.VarChar(80)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  workspace       Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project                      @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  deployment      Deployment                   @relation(fields: [workspaceId, projectId, deploymentId], references: [workspaceId, projectId, id], onDelete: Cascade)

  @@unique([workspaceId, projectId, deploymentId, eventType])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([workspaceId, projectId, createdAt])
  @@map("deployment_outbox_events")
}

model DeploymentSourcePreparation {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String                  @db.Uuid
  projectId          String                  @db.Uuid
  deploymentId       String                  @db.Uuid
  repositoryFullName String                  @db.VarChar(255)
  requestedBranch    String?                 @db.VarChar(255)
  resolvedCommitSha  String                  @db.VarChar(40)
  status             DeploymentSourceStatus  @default(PENDING)
  attempt            Int                     @default(0)
  sourceWorkspaceKey String?                 @db.VarChar(64)
  downloadedBytes    BigInt                  @default(0)
  extractedBytes     BigInt                  @default(0)
  fileCount          Int                     @default(0)
  failureCode        String?                 @db.VarChar(80)
  expiresAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deployment         Deployment              @relation(fields: [workspaceId, projectId, deploymentId], references: [workspaceId, projectId, id], onDelete: Cascade)

  @@unique([workspaceId, projectId, deploymentId])
  @@index([status, expiresAt])
  @@index([workspaceId, projectId, createdAt])
  @@map("deployment_source_preparations")
}

model DeploymentBuild {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                    @db.Uuid
  projectId            String                    @db.Uuid
  deploymentId         String                    @db.Uuid
  sourcePreparationId  String                    @db.Uuid
  resolvedCommitSha    String                    @db.VarChar(40)
  buildAttempt         Int                       @default(1)
  status               DeploymentBuildStatus     @default(QUEUED)
  builderType          String?                   @db.VarChar(40)
  dockerfilePath       String?                   @db.VarChar(500)
  buildContextPath     String?                   @db.VarChar(500)
  imageTag             String?                   @db.VarChar(255)
  imageId              String?                   @db.VarChar(255)
  imageDigest          String?                   @db.VarChar(255)
  artifactType         DeploymentBuildArtifactType?
  artifactLocation     String?                   @db.VarChar(500)
  platform             String?                   @db.VarChar(40)
  imageSizeBytes       BigInt?
  failureCode          String?                   @db.VarChar(80)
  failureMessage       String?                   @db.Text
  executionLeaseToken  String?                   @db.Uuid
  executionLeaseExpiresAt DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  durationMs           Int?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  deployment           Deployment                @relation(fields: [workspaceId, projectId, deploymentId], references: [workspaceId, projectId, id], onDelete: Cascade)
  logs                 DeploymentBuildLog[]
  runtimeInstances DeploymentRuntimeInstance[]
  logEntries DeploymentLogEntry[] @relation("DeploymentLogBuild")

  @@unique([workspaceId, projectId, deploymentId, buildAttempt])
  @@unique([workspaceId, projectId, deploymentId, id])
  @@index([workspaceId, deploymentId, createdAt])
  @@index([status, createdAt])
  @@map("deployment_builds")
}

model DeploymentBuildLog {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String          @db.Uuid
  projectId     String          @db.Uuid
  deploymentId  String          @db.Uuid
  buildId       String          @db.Uuid
  sequence      BigInt
  stream        String          @db.VarChar(16)
  message       String          @db.Text
  createdAt     DateTime        @default(now())
  build         DeploymentBuild @relation(fields: [workspaceId, projectId, deploymentId, buildId], references: [workspaceId, projectId, deploymentId, id], onDelete: Cascade)

  @@unique([workspaceId, projectId, deploymentId, buildId, sequence])
  @@index([workspaceId, projectId, deploymentId, buildId, createdAt])
  @@map("deployment_build_logs")
}

model Build {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String      @db.Uuid
  deploymentId         String      @db.Uuid
  status               BuildStatus @default(QUEUED)
  artifactReference    String?
  imageReference       String?
  immutableImageDigest String?
  startedAt            DateTime?
  finishedAt           DateTime?
  deployment           Deployment  @relation(fields: [workspaceId, deploymentId], references: [workspaceId, id], onDelete: Cascade)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, deploymentId, createdAt])
  @@map("builds")
}

model DeploymentLog {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String     @db.Uuid
  deploymentId String     @db.Uuid
  level        LogLevel
  message      String
  sequence     BigInt
  deployment   Deployment @relation(fields: [workspaceId, deploymentId], references: [workspaceId, id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([workspaceId, deploymentId, sequence])
  @@index([workspaceId, deploymentId, createdAt])
  @@map("deployment_logs")
}

model EnvironmentVariable {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String                @db.Uuid
  projectId       String                @db.Uuid
  environment     DeploymentEnvironment @default(DEVELOPMENT)
  key             String
  encryptedValue  String
  encryptionKeyId String
  project         Project               @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([workspaceId, projectId, environment, key])
  @@index([workspaceId, projectId, environment])
  @@map("environment_variables")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid
  actorId     String?   @db.Uuid
  action      String
  entityType  String
  entityId    String    @db.Uuid
  metadata    Json?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor       User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
  @@map("audit_logs")
}

enum DeploymentRuntimeStatus {
  QUEUED
  CREATING
  STARTING
  RUNNING
  STOPPED
  FAILED
  CANCELLED
}

model DeploymentRuntimeInstance {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String                  @db.Uuid
  projectId            String                  @db.Uuid
  deploymentId         String                  @db.Uuid
  buildId              String                  @db.Uuid
  runtimeAttempt       Int                     @default(1)
  status               DeploymentRuntimeStatus @default(QUEUED)
  containerId          String?                 @db.VarChar(255)
  containerName        String?                 @db.VarChar(255)
  imageId              String?                 @db.VarChar(255)
  imageTag             String?                 @db.VarChar(255)
  containerPort        Int?
  hostPort             Int?
  hostBindingAddress   String?                 @db.VarChar(64)
  networkName          String?                 @db.VarChar(255)
  cpuLimit             Int?
  memoryLimitMb        Int?
  pidsLimit            Int?
  restartCount         Int                     @default(0)
  failureCode          String?                 @db.VarChar(80)
  failureMessage       String?                 @db.Text
  executionLeaseToken  String?                 @db.Uuid
  executionLeaseExpiresAt DateTime?
  startedAt            DateTime?
  readyAt              DateTime?
  stoppedAt            DateTime?
  exitCode             Int?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deployment Deployment @relation(fields: [workspaceId, projectId, deploymentId], references: [workspaceId, projectId, id], onDelete: Cascade, onUpdate: Cascade, map: "dri_deployment_fkey")
  build DeploymentBuild @relation(fields: [workspaceId, projectId, deploymentId, buildId], references: [workspaceId, projectId, deploymentId, id], onDelete: NoAction, onUpdate: Cascade, map: "dri_build_fkey")
  healthStates DeploymentHealthState[]
  logEntries DeploymentLogEntry[] @relation("DeploymentLogRuntime")

  @@unique([workspaceId, projectId, deploymentId, runtimeAttempt], map: "dri_ws_proj_dep_attempt_key")
  @@unique([workspaceId, projectId, deploymentId, id], map: "dri_ws_proj_dep_id_key")
  @@index([workspaceId, deploymentId, createdAt], map: "dri_ws_dep_created_idx")
  @@index([status, createdAt], map: "dri_status_created_idx")
  @@index([status, executionLeaseExpiresAt], map: "dri_status_lease_expires_idx")
  @@index([workspaceId, projectId, deploymentId, buildId], map: "dri_ws_proj_dep_build_idx")
  @@map("deployment_runtime_instances")
}

/// Unified, authoritative deployment log history.
/// Persisted before publication.
/// Sequence uniqueness prevents duplicate cursors.
/// Stable record identities are required for idempotent
/// ingestion across ambiguous transaction retries.
model DeploymentLogEntry {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String               @db.Uuid
  projectId         String               @db.Uuid
  deploymentId      String               @db.Uuid
  buildId           String?              @db.Uuid
  runtimeInstanceId String?              @db.Uuid
  source            DeploymentLogSource
  stream            DeploymentLogStream
  level             DeploymentLogLevel
  message           String               @db.Text
  sequence          BigInt
  eventTimestamp    DateTime
  persistedAt       DateTime             @default(now())
  createdAt         DateTime             @default(now())
  deployment Deployment @relation(fields: [workspaceId, projectId, deploymentId], references: [workspaceId, projectId, id], onDelete: Cascade, onUpdate: Cascade, map: "dle_deployment_fkey")

  build DeploymentBuild? @relation("DeploymentLogBuild", fields: [workspaceId, projectId, deploymentId, buildId], references: [workspaceId, projectId, deploymentId, id], onDelete: NoAction, onUpdate: Cascade, map: "dle_build_fkey")

  runtimeInstance DeploymentRuntimeInstance? @relation("DeploymentLogRuntime", fields: [workspaceId, projectId, deploymentId, runtimeInstanceId], references: [workspaceId, projectId, deploymentId, id], onDelete: NoAction, onUpdate: Cascade, map: "dle_runtime_fkey")

  @@unique([workspaceId, deploymentId, sequence], map: "dle_ws_dep_seq_key")
  @@index([workspaceId, deploymentId, source, sequence], map: "dle_ws_dep_source_seq_idx")
  @@index([workspaceId, deploymentId, level, sequence], map: "dle_ws_dep_level_seq_idx")
  @@index([createdAt], map: "dle_created_idx")
  @@index([workspaceId, deploymentId, stream, sequence], map: "dle_ws_dep_stream_seq_idx")
  @@index([workspaceId, projectId, deploymentId, buildId], map: "dle_ws_proj_dep_build_idx")
  @@index([workspaceId, projectId, deploymentId, runtimeInstanceId], map: "dle_ws_proj_dep_runtime_idx")
  @@map("deployment_log_entries")
}

/// Per-deployment concurrency-safe sequence allocator.
/// Incremented atomically inside the writer transaction so
/// that sequence order matches commit order.
model DeploymentLogSequence {
  workspaceId  String     @db.Uuid
  deploymentId String     @db.Uuid
  value        BigInt     @default(0)
  updatedAt DateTime @default(now()) @updatedAt
  deployment Deployment @relation(fields: [workspaceId, deploymentId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Cascade, map: "dls_deployment_fkey")

  @@id([workspaceId, deploymentId], map: "dls_ws_dep_pk")
  @@map("deployment_log_sequences")
}

/// Bounded, batched notification outbox. One row per committed
/// log batch (never one row per log line). Drives Redis
/// publication of committed cursor ranges.
model DeploymentLogNotificationOutbox {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                 @db.Uuid
  projectId      String                 @db.Uuid
  deploymentId   String                 @db.Uuid
  fromSequence   BigInt
  toSequence     BigInt
  status         DeploymentOutboxStatus @default(PENDING)
  attemptCount   Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  leaseToken     String?                @db.Uuid
  leaseExpiresAt DateTime?
  publishedAt    DateTime?
  lastErrorCode  String?                @db.VarChar(80)
  createdAt      DateTime               @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  deployment Deployment @relation(fields: [workspaceId, projectId, deploymentId], references: [workspaceId, projectId, id], onDelete: Cascade, onUpdate: Cascade, map: "dlno_deployment_fkey")

  @@index([status, nextAttemptAt, createdAt], map: "dlno_status_next_idx")
  @@index([status, leaseExpiresAt], map: "dlno_status_lease_idx")
  @@index([workspaceId, deploymentId, createdAt], map: "dlno_ws_dep_created_idx")
  @@unique([workspaceId, deploymentId, fromSequence, toSequence], map: "dlno_ws_dep_range_key")
  @@index([status, createdAt], map: "dlno_status_created_idx")
  @@map("deployment_log_notification_outbox")
}

enum DeploymentHealthStatus {
  UNKNOWN
  STARTING
  HEALTHY
  DEGRADED
  UNHEALTHY
  RECOVERING
  FAILED
}

enum HealthProbeStatus {
  PASSED
  FAILED
  SKIPPED
}

enum HealthDockerState {
  created
  running
  exited
  restarting
  paused
  dead
  unknown
}

enum HealthFailureReason {
  CONTAINER_UNAVAILABLE
  CONTAINER_NOT_RUNNING
  HTTP_TIMEOUT
  HTTP_UNREACHABLE
  HTTP_STATUS
  RECOVERY_EXECUTION_FAILED
  RECOVERY_EXHAUSTED
  CONTAINER_IDENTITY_MISMATCH
  HTTP_CONNECTION_REFUSED
  HTTP_INVALID_RESPONSE
  HTTP_REDIRECT
  RECOVERY_STALE
  RECOVERY_IDENTITY_MISMATCH
  RECOVERY_PORT_CHANGED
  RECOVERY_DOCKER_UNAVAILABLE
  RECOVERY_TIMEOUT
  RECOVERY_RESTART_UNCERTAIN
}

enum RecoveryAction {
  RESTART
}

enum RecoveryTrigger {
  MANUAL
  AUTOMATIC
}

enum RecoveryStatus {
  REQUESTED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model DeploymentHealthState {
  workspaceId          String                      @db.Uuid
  projectId            String                      @db.Uuid
  deploymentId         String                      @db.Uuid
  runtimeInstanceId    String                      @db.Uuid
  generation           Int
  status               DeploymentHealthStatus      @default(UNKNOWN)
  consecutiveSuccesses Int                         @default(0)
  consecutiveFailures  Int                         @default(0)
  lastCheckedAt        DateTime?
  lastHealthyAt        DateTime?
  nextCheckAt          DateTime?
  lastFailureReason    HealthFailureReason?
  leaseOwnerId         String?                     @db.Uuid
  leaseToken           String?                     @unique(map: "dhs_lease_token_key") @db.Uuid
  leaseExpiresAt       DateTime?
  version              Int                         @default(0)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @default(now()) @updatedAt
  runtime              DeploymentRuntimeInstance   @relation(fields: [workspaceId, projectId, deploymentId, runtimeInstanceId], references: [workspaceId, projectId, deploymentId, id], onDelete: Cascade, onUpdate: Cascade, map: "dhs_runtime_fkey")
  checks               DeploymentHealthCheck[]
  recoveryAttempts     DeploymentRecoveryAttempt[]

  @@id([workspaceId, projectId, deploymentId, runtimeInstanceId, generation], map: "dhs_pkey")
  @@index([nextCheckAt], map: "dhs_due_idx")
  @@map("deployment_health_states")
}

model DeploymentHealthCheck {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String                @db.Uuid
  projectId         String                @db.Uuid
  deploymentId      String                @db.Uuid
  runtimeInstanceId String                @db.Uuid
  generation        Int
  dockerResult      HealthProbeStatus
  dockerState       HealthDockerState?
  httpResult        HealthProbeStatus
  responseLatencyMs Int?
  httpStatus        Int?
  failureReason     HealthFailureReason?
  checkedAt         DateTime              @default(now())
  healthState       DeploymentHealthState @relation(fields: [workspaceId, projectId, deploymentId, runtimeInstanceId, generation], references: [workspaceId, projectId, deploymentId, runtimeInstanceId, generation], onDelete: Cascade, onUpdate: Cascade, map: "dhc_state_fkey")

  @@index([workspaceId, projectId, deploymentId, runtimeInstanceId, generation, checkedAt], map: "dhc_state_time_idx")
  @@index([checkedAt], map: "dhc_retention_idx")
  @@map("deployment_health_checks")
}

model DeploymentRecoveryAttempt {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String                @db.Uuid
  projectId         String                @db.Uuid
  deploymentId      String                @db.Uuid
  runtimeInstanceId String                @db.Uuid
  generation        Int
  action            RecoveryAction
  trigger           RecoveryTrigger
  idempotencyKey    String                @db.Uuid
  status            RecoveryStatus        @default(REQUESTED)
  attemptCount      Int                   @default(0)
  healthVersion     Int?
  restartIssuedAt   DateTime?
  restartSourceStartedAt String?          @db.VarChar(40)
  leaseOwnerId      String?               @db.Uuid
  leaseToken        String?               @unique(map: "dra_lease_token_key") @db.Uuid
  leaseExpiresAt    DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  failureReason     HealthFailureReason?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
  healthState       DeploymentHealthState @relation(fields: [workspaceId, projectId, deploymentId, runtimeInstanceId, generation], references: [workspaceId, projectId, deploymentId, runtimeInstanceId, generation], onDelete: Cascade, onUpdate: Cascade, map: "dra_state_fkey")

  @@unique([workspaceId, projectId, deploymentId, idempotencyKey], map: "dra_deployment_idempotency_key")
  @@index([workspaceId, projectId, deploymentId, runtimeInstanceId, generation, createdAt], map: "dra_state_time_idx")
  @@map("deployment_recovery_attempts")
}
