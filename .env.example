POSTGRES_DB=cloudpilot
POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://cloudpilot:replace-with-a-local-development-password@127.0.0.1:5433/cloudpilot
REDIS_PASSWORD=replace-with-a-local-development-password
REDIS_URL=redis://:replace-with-a-local-development-password@127.0.0.1:6379/0
QUEUE_PREFIX=cloudpilot
QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
QUEUE_BACKOFF_JITTER=0.25
QUEUE_COMPLETED_RETENTION=1000
QUEUE_FAILED_RETENTION=5000
QUEUE_EXECUTION_TIMEOUT_MS=30000
DEPLOYMENT_WORKER_CONCURRENCY=2
DEPLOYMENT_OUTBOX_PUBLISH_INTERVAL_MS=1000
DEPLOYMENT_EXECUTION_LEASE_MS=60000
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TTL_SECONDS=20
SOURCE_WORKSPACE_ROOT=runtime/workspaces
SOURCE_DOWNLOAD_TIMEOUT_MS=60000
SOURCE_MAX_ARCHIVE_BYTES=104857600
SOURCE_MAX_EXTRACTED_BYTES=524288000
SOURCE_MAX_FILE_BYTES=52428800
SOURCE_MAX_FILE_COUNT=20000
SOURCE_MAX_RETRIES=3
SOURCE_WORKSPACE_TTL_SECONDS=3600
SOURCE_CLEANUP_INTERVAL_SECONDS=300
SOURCE_MIN_FREE_BYTES=104857600
# Phase 5.4 isolated Docker build engine (disabled by default).
# Untrusted repository builds require strong isolation that the
# local Docker driver cannot enforce; keep BUILD_ENABLED=false
# unless a trusted, isolated builder is configured.
BUILD_ENABLED=false
BUILD_EXECUTOR=buildkit
BUILD_TRUSTED_LOCAL_ONLY=true
BUILD_TRUSTED_REPOSITORIES=
BUILD_PLATFORM=linux/amd64
BUILD_MAX_CONCURRENCY=1
BUILD_TIMEOUT_MS=900000
BUILD_CPU_LIMIT=2
BUILD_MEMORY_LIMIT_MB=2048
BUILD_MAX_CONTEXT_BYTES=524288000
BUILD_MAX_LOG_BYTES=10485760
BUILD_MAX_RETRIES=1
BUILD_ARTIFACT_TTL_SECONDS=86400
# Phase 5.5 secure container runtime engine (disabled by default).
# The local Docker driver cannot enforce strong isolation for
# untrusted workloads; keep RUNTIME_ENABLED=false unless the
# host is a trusted, single-tenant environment.
RUNTIME_ENABLED=false
RUNTIME_TRUSTED_LOCAL_ONLY=true
RUNTIME_BIND_HOST=127.0.0.1
RUNTIME_CONTAINER_PORT=3000
RUNTIME_CPU_LIMIT=1
RUNTIME_MEMORY_LIMIT_MB=1024
RUNTIME_PIDS_LIMIT=256
RUNTIME_STARTUP_TIMEOUT_MS=30000
RUNTIME_HEALTH_CHECK_INTERVAL_MS=5000
RUNTIME_STOP_TIMEOUT_MS=10000
RUNTIME_MAX_CONCURRENCY=2
RUNTIME_MAX_RETRIES=1
RUNTIME_NETWORK_PREFIX=cloudpilot
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_INSTALLATION_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/github/installations/authorize/callback
AUTH_SECRET=replace-with-at-least-32-random-local-characters
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT_VARIABLE_ENCRYPTION_KEY=

# Phase 5.6 real-time deployment logging (disabled by default)
DEPLOYMENT_LOGS_ENABLED=false
LOG_STREAMING_ENABLED=false
LOG_RUNTIME_COLLECTION_ENABLED=false
LOG_MAX_ENTRY_BYTES=16384
LOG_BATCH_SIZE=100
LOG_FLUSH_INTERVAL_MS=250
LOG_MAX_DEPLOYMENT_BYTES=52428800
LOG_RETENTION_DAYS=7
LOG_HISTORY_PAGE_SIZE=200
LOG_HISTORY_MAX_PAGE_SIZE=1000
LOG_SOCKET_MAX_SUBSCRIPTIONS=10
LOG_CLIENT_MAX_ENTRIES=5000
LOG_NOTIFICATION_PUBLISH_INTERVAL_MS=1000
LOG_PERMISSION_REVALIDATE_MS=30000
LOG_REDIS_PREFIX=cloudpilot:logs
LOG_RUNTIME_HISTORICAL_MS=300000
LOG_COLLECTOR_LOCK_TTL_MS=15000
LOG_COLLECTOR_RENEW_MS=5000

# Opt-in operator metrics. Use a private file holding a random base64url bearer token.
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
API_METRICS_PORT=9464
WORKER_METRICS_PORT=9465
# METRICS_TOKEN_FILE=
